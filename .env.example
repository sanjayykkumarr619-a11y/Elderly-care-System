# Copy to .env and fill in real values, OR export these as real
# environment variables before running `python server.py`. Never commit
# a real .env file or paste real credentials into chat.
#
# This prototype's Python stdlib-only server does not auto-load .env
# files (no external dotenv dependency) - set these as actual
# environment variables, e.g. in PowerShell:
#   $env:SMTP_USERNAME = "your-app-gmail-address@gmail.com"
#   $env:SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
#   python server.py
# Or, for local development, put the same values in local_settings.py
# (see local_settings.py.example) - config.py reads that file too.

# Mail server host/port. Defaults shown are for Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The mailbox to authenticate as when sending. For Gmail this must be
# paired with an App Password below, not your normal account password.
SMTP_USERNAME=your-app-gmail-address@gmail.com

# A 16-character Gmail "App Password" (Google Account -> Security ->
# 2-Step Verification -> App Passwords) - never your real Gmail password.
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# The "From" address shown to recipients. Usually the same as
# SMTP_USERNAME.
SENDER_EMAIL=your-app-gmail-address@gmail.com
